FROM ros:jazzy

# 1) ROS-/System-Pakete
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-colcon-common-extensions \
    python3-opencv \
    git \
    build-essential \
    libyaml-cpp-dev \
    libboost-all-dev \
    zlib1g-dev \
    libeigen3-dev \
    linux-libc-dev \
    libproj-dev \
    proj-bin \
    python3-pyproj\
    ros-jazzy-geographic-msgs \
    nano \
    tree \
    nlohmann-json3-dev \
    ros-jazzy-cv-bridge \
    ros-jazzy-sensor-msgs \
    ros-jazzy-std-msgs \
    ros-jazzy-rosidl-default-generators \
    ros-jazzy-rosidl-default-runtime \
    ros-jazzy-geometry-msgs \
    ros-jazzy-builtin-interfaces \
    && rm -rf /var/lib/apt/lists/*

# 2) Arbeitsverzeichnis
WORKDIR /app

# 3) Python-Dependencies 
COPY requirements-web.txt /app/requirements.txt
RUN pip3 install --no-cache-dir -r /app/requirements.txt --break-system-packages

# 4) Static-Files (HTML, JS, CSS)
# Create static directory structure
RUN mkdir -p /app/static/media

# Copy static web files (HTML, JS, CSS)
# These are baked into the image for production use
COPY static/ /app/static/

# Copy media files (images, logos, etc.) if media directory exists
# Note: This will fail if media/ doesn't exist - ensure it exists or comment out
COPY media/ /app/static/media/

# Optional: FastDDS configuration
COPY fastdds.xml /tmp/fastdds.xml

# 5) Data-Verzeichnis
RUN mkdir -p /data

# 6) Port & Volumes
EXPOSE 8020
VOLUME ["/data", "/app/ros2_ws"]

# 7) Start: direkt in eine Shell mit gesourcter ROS-Umgebung
CMD ["bash", "-c", "source /opt/ros/${ROS_DISTRO}/setup.bash && exec bash"]
